@startuml Component_Diagram
!theme plain

package "Frontend Layer" {
  component [Web Browser] as Browser
  component [HTML Templates] as Templates
  component [JavaScript] as JS
  component [CSS] as CSS
}

package "Application Layer" {
  component [Flask Application] as Flask
  component [Routes] as Routes
  component [Business Logic] as Logic
}

package "Service Layer" {
  component [QR Code Service] as QRService
  component [Face Recognition Service] as FaceService
  component [Database Service] as DBService
}

package "Data Layer" {
  database "SQLite Database" as DB
  folder "Uploads" as Uploads
}

package "External Libraries" {
  component [qrcode] as QRCodeLib
  component [face_recognition] as FaceLib
  component [SQLAlchemy] as ORM
  component [Pillow] as PIL
  component [opencv-python] as CV2
}

Browser --> Templates : renders
Browser --> JS : executes
Browser --> CSS : styles
Browser --> Flask : HTTP requests

Flask --> Routes : routes requests
Routes --> Logic : processes
Logic --> QRService : generates QR codes
Logic --> FaceService : processes faces
Logic --> DBService : data operations

QRService --> QRCodeLib : uses
QRService --> PIL : image processing
FaceService --> FaceLib : face detection
FaceService --> CV2 : image processing
DBService --> ORM : database access

ORM --> DB : queries
Logic --> Uploads : file storage

@enduml

