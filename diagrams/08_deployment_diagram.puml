@startuml Deployment_Diagram
!theme plain

node "Client Machine" {
  artifact "Web Browser" as Browser
  artifact "Camera" as Camera
}

node "Server Machine" {
  artifact "Flask Application" as Flask
  database "SQLite Database\n(user table)" as DB
  folder "Templates" as Templates
  folder "Static Files" as Static
  folder "Uploads" as Uploads
}

note right of DB
  **Database Schema:**
  - id: INTEGER
  - name: VARCHAR
  - face_encoding: TEXT
  - qr_code_data: VARCHAR
  - created_at: DATETIME
end note

node "Python Environment" {
  component "Flask" as FlaskLib
  component "SQLAlchemy" as ORM
  component "face_recognition" as FaceLib
  component "qrcode" as QRCodeLib
  component "Pillow" as PIL
  component "opencv-python" as CV2
}

Browser --> Flask : HTTP/HTTPS
Camera --> Browser : MediaStream
Flask --> DB : SQL queries
Flask --> Templates : renders
Flask --> Static : serves
Flask --> Uploads : stores files
Flask --> FlaskLib : uses
Flask --> ORM : uses
Flask --> FaceLib : uses
Flask --> QRCodeLib : uses
Flask --> PIL : uses
Flask --> CV2 : uses

@enduml

