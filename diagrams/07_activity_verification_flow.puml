@startuml Activity_Verification_Flow
!theme plain
start

:User navigates to /verify;
:Display verification form;

:User scans QR code or enters user ID;
:User captures/uploads face image;

:Load QR code data;
:Query database for user;

if (User found?) then (no)
  :Display error: "User not found";
  stop
else (yes)
  :Load face image;
  :Detect face in image;
  
  if (Face detected?) then (no)
    :Display error: "No face detected";
    stop
  else (yes)
    :Extract face encoding;
    :Load stored face encoding from user;
    :Calculate face distance;
    :Compare distance with threshold (0.6);
    
    if (Distance < 0.6?) then (yes)
      :Display "Access Granted";
      :Show user information;
      stop
    else (no)
      :Display "Access Denied";
      :Show mismatch information;
      stop
    endif
  endif
endif

@enduml

