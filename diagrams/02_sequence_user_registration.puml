@startuml Sequence_User_Registration
!theme plain

actor User
participant "Web Browser" as Browser
participant "Flask App" as Flask
participant "Face Recognition" as FaceRec
participant "QR Generator" as QRGen
participant "Database" as DB

User -> Browser: Navigate to /add_user
Browser -> Flask: GET /add_user
Flask -> Browser: Return add_user.html
Browser -> User: Display form

User -> Browser: Enter name, upload face image
Browser -> Flask: POST /add_user (name, face_image)

Flask -> FaceRec: load_image_file(face_image)
FaceRec -> FaceRec: Detect faces
FaceRec -> FaceRec: Extract face encodings
FaceRec -> Flask: Return face_encoding[]

alt No face detected
    Flask -> Browser: Error: "No face detected"
    Browser -> User: Display error
else Multiple faces detected
    Flask -> Browser: Error: "Multiple faces detected"
    Browser -> User: Display error
else Single face detected
    Flask -> DB: Create User(name, face_encoding, "temp")
    DB -> DB: Generate user ID
    DB -> Flask: Return user with ID
    
    Flask -> DB: Update qr_code_data = user_id
    Flask -> QRGen: generate_qr_code(user_id)
    QRGen -> QRGen: Create QR code image
    QRGen -> Flask: Return QR image
    
    Flask -> DB: Commit transaction
    Flask -> Browser: Return JSON (user_id, name, qr_code)
    Browser -> User: Display QR code
end

@enduml

