@startuml Sequence_Verification
!theme plain

actor User
participant "Web Browser" as Browser
participant "QR Scanner" as Scanner
participant "Camera" as Camera
participant "Flask App" as Flask
participant "Face Recognition" as FaceRec
participant "Database" as DB

User -> Browser: Navigate to /verify
Browser -> Flask: GET /verify
Flask -> Browser: Return verify.html
Browser -> User: Display verification form

User -> Browser: Click "Scan QR Code"
Browser -> Scanner: Start QR scanner
Scanner -> Camera: Request camera access
Camera -> Scanner: Video stream
Scanner -> Scanner: Detect QR code
Scanner -> Browser: QR code data (user_id)
Browser -> Browser: Fill qr_code_data field

User -> Browser: Click "Capture Face" or upload image
alt Camera capture
    Browser -> Camera: Request camera access
    Camera -> Browser: Video stream
    User -> Browser: Click "Capture Photo"
    Browser -> Browser: Capture frame to canvas
    Browser -> Browser: Convert to blob/file
end

User -> Browser: Click "Verify Access"
Browser -> Flask: POST /verify (qr_code_data, face_image)

Flask -> DB: Query User by qr_code_data
DB -> Flask: Return User object

alt User not found
    Flask -> Browser: Error: "User not found"
    Browser -> User: Display error
else User found
    Flask -> FaceRec: load_image_file(face_image)
    FaceRec -> FaceRec: Detect faces
    FaceRec -> FaceRec: Extract face encoding
    FaceRec -> Flask: Return face_encoding[]
    
    alt No face detected
        Flask -> Browser: Error: "No face detected"
        Browser -> User: Display error
    else Face detected
        Flask -> Flask: Load stored face_encoding from User
        Flask -> FaceRec: face_distance(stored, captured)
        FaceRec -> Flask: Return distance
        
        Flask -> Flask: Compare distance < 0.6
        
        alt Match (distance < 0.6)
            Flask -> Browser: JSON {match: true, user_name, face_distance}
            Browser -> User: Display "Access Granted"
        else No match (distance >= 0.6)
            Flask -> Browser: JSON {match: false, user_name, face_distance}
            Browser -> User: Display "Access Denied"
        end
    end
end

@enduml

